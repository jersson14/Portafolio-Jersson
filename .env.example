# Copia este archivo como .env.local y pega tu clave. Nunca uses el prefijo VITE_: la expondría en el navegador.
OPENAI_API_KEY=
# Opcional: modelo (por defecto gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna
# Opcional: pon "off" solo si tu modelo no acepta reasoning_effort (p. ej. gpt-4.1-mini)
# OPENAI_REASONING=off

# Opcional: preguntas por visitante (por defecto 10) y cada cuántas horas se renuevan (por defecto 24)
# AGENT_LIMIT=10
# AGENT_WINDOW_HOURS=24
# Opcional: Upstash Redis, para que el cupo por IP sea exacto en producción
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional: voz del agente (cedar, marin, coral, ash…)
# OPENAI_VOICE=cedar
